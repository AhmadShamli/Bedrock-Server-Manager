# Example Nginx Reverse Proxy Configuration for Bedrock Server Manager (BSM)

server {
    listen 80;
    server_name bsm.example.com;

    # Redirect all HTTP traffic to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name bsm.example.com;

    # SSL Certificates (e.g. Certbot / Let's Encrypt)
    ssl_certificate     /etc/letsencrypt/live/bsm.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bsm.example.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Allow uploading large Minecraft worlds (.mcworld) and behavior/resource packs
    client_max_body_size 500M;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;

        # Forward real client IP and TLS headers
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support for interactive BDS console & real-time telemetry
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Standard timeouts
        proxy_connect_timeout 5s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
