# Example Caddyfile Configuration for Bedrock Server Manager (BSM)

bsm.example.com {
    # Automatic HTTPS via Let's Encrypt / ZeroSSL

    # Allow uploading large Minecraft worlds (.mcworld) and behavior/resource packs
    request_body {
        max_size 500MB
    }

    # Reverse proxy to local BSM daemon (WebSockets handled automatically by Caddy)
    reverse_proxy 127.0.0.1:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
